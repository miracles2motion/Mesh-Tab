# ========================================================
# MESHTAB ENVIRONMENT CONFIGURATION
# ========================================================
# Copy this file to .env.local and fill in the values below.
# DO NOT commit your .env.local file to version control.

# --------------------------------------------------------
# 1. Upstash Redis (Required for Offline Sync & Caching)
# --------------------------------------------------------
UPSTASH_REDIS_REST_URL="your_upstash_redis_url_here"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token_here"

# --------------------------------------------------------
# 2. Monad Testnet Web3 Config (Required)
# --------------------------------------------------------
NEXT_PUBLIC_MONAD_RPC_URL="https://testnet-rpc.monad.xyz"
NEXT_PUBLIC_MOCK_AUSD_ADDRESS="your_deployed_ausd_address_here"
NEXT_PUBLIC_MESH_TAB_LEDGER_ADDRESS="your_deployed_meshtab_address_here"

# --------------------------------------------------------
# 3. Privy Authentication (Required)
# --------------------------------------------------------
# Get this from your Privy Developer Dashboard
NEXT_PUBLIC_PRIVY_APP_ID="your_privy_app_id_here"

# --------------------------------------------------------
# 4. Pimlico Paymaster (Account Abstraction & Gasless UX)
# --------------------------------------------------------
# Note: Do NOT put your Pimlico API key here! 
# Gasless transactions (like the 5k testnet Agora claim) are securely 
# routed and sponsored through Privy's Smart Wallets SDK. 
# You must configure your Pimlico Paymaster URL directly 
# inside your Privy Developer Dashboard to keep your keys safe.

# --------------------------------------------------------
# 5. Envio HyperIndex Indexer (Optional/Future)
# --------------------------------------------------------
NEXT_PUBLIC_ENVIO_GRAPHQL_URL="https://indexer.envio.dev/v1/graphql"
